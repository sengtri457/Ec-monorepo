DJANGO_SECRET_KEY=dev-secret-key-order-service-replace-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,order-service,gateway

# Database per Service (order_db)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=order_db
DB_USER=order_user
DB_PASSWORD=order_password
DB_HOST=postgres
DB_PORT=5432

PORT=8003

# Downstream Service URLs
USER_SERVICE_URL=http://user-service:8000
PRODUCT_SERVICE_URL=http://product-service:8000
PAYMENT_SERVICE_URL=http://payment-service:8000
NOTIFICATION_SERVICE_URL=http://notification-service:8000

JWT_SECRET_KEY=shared-jwt-secret-key-change-in-production
