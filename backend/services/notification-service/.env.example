DJANGO_SECRET_KEY=dev-secret-key-notification-service-replace-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,notification-service,gateway

# Database per Service (notification_db)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=notification_db
DB_USER=notification_user
DB_PASSWORD=notification_password
DB_HOST=postgres
DB_PORT=5432

PORT=8005

# Notification provider settings (Telegram / Email)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
