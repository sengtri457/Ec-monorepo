DJANGO_SECRET_KEY=dev-secret-key-product-service-replace-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,product-service,gateway

# Database per Service (product_db)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=product_db
DB_USER=product_user
DB_PASSWORD=product_password
DB_HOST=postgres
DB_PORT=5432

PORT=8002
