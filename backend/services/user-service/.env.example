DJANGO_SECRET_KEY=dev-secret-key-user-service-replace-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,user-service,gateway

# Database per Service (user_db)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=user_db
DB_USER=user_user
DB_PASSWORD=user_password
DB_HOST=postgres
DB_PORT=5432

# Service Port
PORT=8001
JWT_SECRET_KEY=shared-jwt-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24
