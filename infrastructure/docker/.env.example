# ============================================================
# Docker Compose Environment Template
# Copy this file to .env and fill in your real production secrets.
# NEVER commit the real .env file to Git!
# ============================================================

# --- Database Master Credentials ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pgsql
POSTGRES_PORT=5433

# --- Django Microservice Secret Keys ---
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
USER_SERVICE_SECRET_KEY=user-service-docker-secret-key-12345
PRODUCT_SERVICE_SECRET_KEY=product-service-docker-secret-key-12345
ORDER_SERVICE_SECRET_KEY=order-service-docker-secret-key-12345
PAYMENT_SERVICE_SECRET_KEY=payment-service-docker-secret-key-12345
NOTIFICATION_SERVICE_SECRET_KEY=notification-service-docker-secret-key-12345

# --- Shared JWT Secret (Used for cross-service auth) ---
JWT_SECRET_KEY=shared-jwt-secret-key-change-in-production

# --- Bakong KHQR Production Keys ---
BAKONG_ACCOUNT_ID=clothes@abaa
BAKONG_MERCHANT_NAME=Clothes Apparel Co
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_PHONE_NUMBER=
BAKONG_API_URL=https://api-bakong.nbc.gov.kh/v1/
BAKONG_API_TOKEN=

# --- Notification Providers (Telegram & Email) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Google OAuth 2.0 Credentials ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
