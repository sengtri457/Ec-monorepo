{
  "name": "admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:worker": "node -e \"const fs=require('fs'),p=require('path');fs.mkdirSync('public',{recursive:true});fs.copyFileSync(require.resolve('maplibre-gl/dist/maplibre-gl-worker.mjs'),p.join('public','maplibre-gl-worker.mjs'))\"",
    "predev": "pnpm run sync:worker",
    "dev": "next dev -p 3001",
    "prebuild": "pnpm run sync:worker",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "@ec/map-basemap": "workspace:*",
    "@ec/types": "workspace:*",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "maplibre-gl": "^6.19.0",
    "next": "^16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.2"
  }
}
